{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "deep",
					"name": "Deep teal",
					"color": "#01303b"
				},
				{
					"slug": "teal",
					"name": "Teal",
					"color": "#006769"
				},
				{
					"slug": "lime",
					"name": "Lime",
					"color": "#d1f462"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#edf4d9"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#000000"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inclusive-sans",
					"name": "Inclusive Sans",
					"fontFamily": "\"Inclusive Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inclusive Sans",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inclusive-sans/inclusive-sans-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inclusive Sans",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inclusive-sans/inclusive-sans-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Inclusive Sans",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inclusive-sans/inclusive-sans-italic-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inclusive Sans",
							"fontStyle": "italic",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inclusive-sans/inclusive-sans-italic-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "label",
					"name": "Label",
					"size": "18px",
					"fluid": false
				},
				{
					"slug": "kicker",
					"name": "Kicker",
					"size": "20px",
					"fluid": {
						"min": "18px",
						"max": "20px"
					}
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "24px",
					"fluid": {
						"min": "19px",
						"max": "24px"
					}
				},
				{
					"slug": "button",
					"name": "Button",
					"size": "28px",
					"fluid": {
						"min": "20px",
						"max": "28px"
					}
				},
				{
					"slug": "heading",
					"name": "Heading",
					"size": "40px",
					"fluid": {
						"min": "29px",
						"max": "40px"
					}
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "62px",
					"fluid": {
						"min": "40px",
						"max": "62px"
					}
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1220px"
		},
		"custom": {
			"radius": {
				"card": "10px",
				"pill": "50px"
			},
			"border": {
				"width": "2px"
			}
		},
		"useRootPaddingAwareAlignments": true,
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "16px"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "clamp(20px, 2.5vw, 32px)"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(32px, 4vw, 56px)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(48px, 6vw, 88px)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inclusive-sans)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "400",
			"lineHeight": "1.3"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--deep)"
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--teal)"
				},
				"typography": {
					"fontWeight": "600",
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--lime)",
					"text": "var(--wp--preset--color--deep)"
				},
				"border": {
					"color": "var(--wp--preset--color--teal)",
					"radius": "var(--wp--custom--radius--pill)",
					"style": "solid",
					"width": "var(--wp--custom--border--width)"
				},
				"spacing": {
					"padding": {
						"top": "0.5em",
						"bottom": "0.5em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--button)",
					"fontWeight": "700",
					"textDecoration": "underline",
					"textTransform": "uppercase"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--button)",
					"fontWeight": "700"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "clamp(16px, 7.5vw, 110px)",
				"right": "clamp(16px, 7.5vw, 110px)"
			},
			"blockGap": "1em"
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-banner",
			"title": "Full page (no banner)",
			"postTypes": [
				"page"
			]
		}
	]
}
